# Which provider the sidebar uses when it does not ask for one explicitly.
# "azure" (Azure OpenAI) is the production path; "anthropic" is also supported.
LLM_PROVIDER=azure

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Tutor text-to-speech (optional; the Teach button hides without it) ----
# Preferred: a TTS deployment (e.g. gpt-4o-mini-tts) on the SAME Azure resource
# as above. audio/speech needs a newer api-version than chat, hence its own var.
AZURE_OPENAI_TTS_DEPLOYMENT=
AZURE_OPENAI_TTS_API_VERSION=2025-03-01-preview
# Fallback: a plain OpenAI key (uses gpt-4o-mini-tts unless TTS_MODEL is set).
OPENAI_API_KEY=
TTS_MODEL=
# Voice + delivery. Voices: alloy, echo, fable, onyx, nova, shimmer, ...
TTS_VOICE=nova
TTS_INSTRUCTIONS=

# ---- Anthropic ----
# ---- Live voice agent (Azure OpenAI Realtime) ----
# Reuses AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY above.
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2
AZURE_OPENAI_REALTIME_API_VERSION=2025-04-01-preview
AZURE_OPENAI_REALTIME_VOICE=alloy

# ---- Anthropic ----
ANTHROPIC_API_KEY=<your-key>
ANTHROPIC_MODEL=claude-opus-5

PORT=8787
